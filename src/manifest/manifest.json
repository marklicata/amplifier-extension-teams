{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.24/MicrosoftTeams.schema.json",
  "manifestVersion": "1.24",
  "version": "1.0.1",
  "id": "{{TEAMS_APP_ID}}",
  "name": {
    "short": "Amplifier",
    "full": "Amplifier AI Development Assistant"
  },
  "developer": {
    "name": "Amplifier Team",
    "websiteUrl": "https://github.com/microsoft/amplifier",
    "privacyUrl": "https://github.com/microsoft/amplifier",
    "termsOfUseUrl": "https://github.com/microsoft/amplifier"
  },
  "description": {
    "short": "AI development assistant",
    "full": "Amplifier brings AI-powered development capabilities into Teams with specialized agents, code analysis, and automated workflows."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#0078D4",
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "declarativeAgent",
        "file": "declarativeAgent.json"
      }
    ]
  },
  "validDomains": [
    "{{AMPLIFIER_API_DOMAIN}}"
  ]
}
