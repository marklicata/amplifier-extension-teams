# Amplifier API Configuration
AMPLIFIER_API_URL=https://amplifier-api.gentlebay-e0c2022c.eastus.azurecontainerapps.io
AMPLIFIER_API_KEY=app_your_api_key_here
AMPLIFIER_BASE_CONFIG_ID=your-config-id-here
AMPLIFIER_BASE_CONFIG_NAME=chat-bundle

# Teams Bot Configuration (from Azure Bot Registration)
MICROSOFT_APP_ID=your-bot-app-id-here
MICROSOFT_APP_PASSWORD=your-bot-app-password-here
MICROSOFT_APP_TYPE=MultiTenant

# Bot Service Configuration
BOT_SERVICE_URL=https://your-bot-url.azurewebsites.net
PORT=3978

# Session Configuration
SESSION_TIMEOUT_MINUTES=60
MAX_SESSIONS_PER_USER=10
